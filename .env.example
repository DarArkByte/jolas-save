# JOLAS SAVE — Required Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# cPanel MySQL connection string
# Format: mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME
# On cPanel shared hosting, the host is always 'localhost'
DATABASE_URL="mysql://jolascom_DBUSER:YOUR_DB_PASSWORD@localhost:3306/jolascom_DBNAME"

# ─── AUTHENTICATION ───────────────────────────────────────────────────────────
# Strong random secret for JWT signing — minimum 32 characters
JWT_SECRET="change-this-to-a-long-random-secret-string"

# ─── APPLICATION ──────────────────────────────────────────────────────────────
# Port the Express server listens on (cPanel Node.js sets this automatically)
PORT=3001

# Set to 'production' on the live server
NODE_ENV="production"

# ─── OPTIONAL ─────────────────────────────────────────────────────────────────
# Gemini API key (if used)
GEMINI_API_KEY="your-gemini-api-key"
